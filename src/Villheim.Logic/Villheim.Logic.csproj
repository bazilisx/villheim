<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that decides how villages behave. The core plugin loads this DLL from memory and
    reloads it whenever the file changes, so it can be rebuilt and swapped while Valheim is running.
  -->
  <PropertyGroup>
    <AssemblyName>Villheim.Logic</AssemblyName>
    <RootNamespace>Villheim.Logic</RootNamespace>
    <Version>0.1.0</Version>
    <!-- A build stamp in the informational version, so the log and the game show which build is live. -->
    <BuildTime>$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmmss"))</BuildTime>
    <SourceRevisionId>build$(BuildTime)</SourceRevisionId>
  </PropertyGroup>

  <!-- Adds the git commit to the stamp, so it can be matched with the commit on GitHub. -->
  <Target Name="StampCommit" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="VillheimCommit" />
      <Output TaskParameter="ExitCode" PropertyName="VillheimCommitExit" />
    </Exec>
    <PropertyGroup Condition="'$(VillheimCommitExit)' == '0'">
      <SourceRevisionId>commit-$(VillheimCommit)-$(BuildTime)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Villager lines, read by Villagers/DialogueLibrary.cs. Built into the DLL so they reload with it. -->
  <ItemGroup>
    <EmbeddedResource Include="Dialogue\*.txt" LogicalName="Villheim.Logic.Dialogue.%(Filename)%(Extension)" />
    <!-- Culture data (names, looks, feasts), read by Village/Cultures.cs. -->
    <EmbeddedResource Include="Cultures\*.txt" LogicalName="Villheim.Logic.Cultures.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Villheim\Villheim.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyToValheim" AfterTargets="Build" Condition="'$(ValheimInstall)' != '' And Exists('$(ValheimInstall)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ValheimInstall)\BepInEx\plugins\Villheim" />
  </Target>

</Project>
