<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that decides how villages behave. The core plugin loads this DLL from memory and
    reloads it whenever the file changes, so it can be rebuilt and swapped while Valheim is running.
  -->
  <PropertyGroup>
    <AssemblyName>Villheim.Logic</AssemblyName>
    <RootNamespace>Villheim.Logic</RootNamespace>
    <Version>0.1.0</Version>
    <!-- A build stamp in the informational version, so the log and the game show which build is live. -->
    <BuildTime>$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmmss"))</BuildTime>
    <SourceRevisionId>build$(BuildTime)</SourceRevisionId>
  </PropertyGroup>

  <!-- Adds the git commit to the stamp, so it can be matched with the commit on GitHub. -->
  <Target Name="StampCommit" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="VillheimCommit" />
      <Output TaskParameter="ExitCode" PropertyName="VillheimCommitExit" />
    </Exec>
    <PropertyGroup Condition="'$(VillheimCommitExit)' == '0'">
      <SourceRevisionId>commit-$(VillheimCommit)-$(BuildTime)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Villager lines, read by Villagers/DialogueLibrary.cs. Built into the DLL so they reload with it. -->
  <ItemGroup>
    <EmbeddedResource Include="Dialogue\*.txt" LogicalName="Villheim.Logic.Dialogue.%(Filename)%(Extension)" />
    <!-- Culture data (names, looks, feasts), read by Village/Cultures.cs. -->
    <EmbeddedResource Include="Cultures\*.txt" LogicalName="Villheim.Logic.Cultures.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Villheim\Villheim.csproj" Private="false" />
  </ItemGroup>

  <!--
    The blueprint lab's generator, run in game by Jint (Generator/LabEngine.cs). lab.js is made by
    tools/blueprint-lab/lib/build_engine.js. The packages are only downloaded here; the netstandard2.1 builds are
    referenced by path and copied next to the DLL, because those are the ones that ship (Unity's Mono has
    netstandard 2.1, so they need only System.Runtime.CompilerServices.Unsafe besides each other).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Generator\lab.js" LogicalName="Villheim.Logic.Generator.lab.js" />
    <PackageReference Include="Jint" Version="4.17.0" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Acornima" Version="1.7.0" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="Jint" HintPath="$(PkgJint)\lib\netstandard2.1\Jint.dll" Private="false" />
    <Reference Include="Acornima" HintPath="$(PkgAcornima)\lib\netstandard2.1\Acornima.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <JsEngineFile Include="$(PkgJint)\lib\netstandard2.1\Jint.dll" />
    <JsEngineFile Include="$(PkgAcornima)\lib\netstandard2.1\Acornima.dll" />
    <JsEngineFile Include="$(PkgSystem_Runtime_CompilerServices_Unsafe)\lib\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
  </ItemGroup>

  <Target Name="CopyJsEngine" AfterTargets="Build">
    <Copy SourceFiles="@(JsEngineFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToValheim" AfterTargets="Build" Condition="'$(ValheimInstall)' != '' And Exists('$(ValheimInstall)')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ValheimInstall)\BepInEx\plugins\Villheim" />
    <Copy SourceFiles="@(JsEngineFile)" DestinationFolder="$(ValheimInstall)\BepInEx\plugins\Villheim" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
