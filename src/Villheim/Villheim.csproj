<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core plugin: prefabs, components, patches and the logic loader.
    Changes here need a game restart, so keep it small and stable.
  -->
  <PropertyGroup>
    <!-- Keeps the core file the same between commits, so the updater only asks for a restart when the core really changed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>Villheim</AssemblyName>
    <RootNamespace>Villheim</RootNamespace>
    <!-- Fixed so logic builds always bind to the loaded core. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <Target Name="CopyToValheim" AfterTargets="Build" Condition="'$(ValheimInstall)' != '' And Exists('$(ValheimInstall)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimInstall)\BepInEx\plugins\Villheim" />
  </Target>

</Project>
